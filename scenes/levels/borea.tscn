modulate = Color(1, 1, 1, 0.7)
offset_left = 14.0
offset_top = 12.0
offset_right = 420.0
offset_bottom = 160.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.75)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 13
text = "WASD — движение     Мышь — камера     L — вид от 1-го лица
Пробел — прыжок     Shift (держать) — бег
Ctrl: стоя — сесть, на бегу — на пузо, держать — тихий ход
E — взять / поднять друга / катить глыбу     Q (держать) — замах и бросок
ЛКМ (держать) — раскрутить крюк     ПКМ — тянуть / смотать     R — разбить лёд другу
F (держать) — оторвать другу руку/ногу     E с деталью рядом с другом (держать) — прикрутить"

