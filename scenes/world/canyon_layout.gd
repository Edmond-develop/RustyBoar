static var _grid := PackedFloat32Array()
const CELL := 2.0
static var _nx := 0
static var _nz := 0


## Подписанное расстояние до края ущелья: < 0 — внутри ущелья (пропасть), > 0 — в толще плато
static func carve_d(x: float, z: float) -> float:
	if _grid.is_empty():
		_build_grid()
	var fx := (x - X_MIN) / CELL
	var fz := (z - Z_MIN) / CELL
	if fx < 0.0 or fz < 0.0 or fx >= _nx - 1 or fz >= _nz - 1:
		return 100.0
	var ix := int(fx)
	var iz := int(fz)
	var tx := fx - ix
	var tz := fz - iz
	var a := _grid[iz * _nx + ix]
	var b := _grid[iz * _nx + ix + 1]
	var c := _grid[(iz + 1) * _nx + ix]
	var d := _grid[(iz + 1) * _nx + ix + 1]
	return lerpf(lerpf(a, b, tx), lerpf(c, d, tx), tz)


## Насколько стена отступает в этом месте (0…3.3 м): выступы, ниши и рёбра — стены не плоские
static func wobble(x: float, z: float) -> float:
	var big := 1.1 + 0.75 * sin(0.11 * x + 0.07 * z) * cos(0.09 * z - 0.05 * x) + 0.35 * sin(0.29 * x + 1.3) * sin(0.33 * z + 0.4)
	# частые вертикальные «рёбра» и ниши на стенах — стены не гладкие
	var ribs := 0.55 * (1.0 + sin(0.47 * x + 0.21 * z) * sin(0.41 * z - 0.17 * x))
	return big + ribs


## Береговая кромка пруда: насколько она шире 4 м в этой точке (0…3.4 м) — берег не по линейке
static func pool_rim_extra(x: float, z: float) -> float:
	if z < -640.0:
		return 0.0          # у северного края каньона кромка не ближе к берегу старого озера
	return clampf(1.6 + 1.2 * sin(0.23 * x + 0.11 * z) * cos(0.19 * z - 0.13 * x) + 0.6 * sin(0.6 * x + 0.4 * z), 0.0, 3.4)


## Расстояние до стены с учётом неровностей (по нему строится рельеф)
static func wall_d(x: float, z: float) -> float:
	return carve_d(x, z) - wobble(x, z)


## Высота стены ущелья в точке (без мелкого шума рельефа)
static func wall_height(x: float, z: float) -> float:
	return lerpf(ABYSS_Y, PLATEAU, smoothstep(0.0, WALL, wall_d(x, z)))


## Внутри пещеры (пол тоннеля или зала)
static func in_cave(x: float, z: float, pad: float = 0.0) -> bool:
	if Vector2(x - CAVE_HALL.x, z - CAVE_HALL.y).length() < CAVE_HALL.z + pad:
		return true
	return _seg_dist(Vector2(x, z), CAVE_MOUTH, CAVE_END) < CAVE_HALF + pad \
		and x <= CAVE_MOUTH.x + pad and x >= CAVE_END.x - 6.0


static func _seg_dist(p: Vector2, a: Vector2, b: Vector2) -> float:
	var ab := b - a
	var t := 0.0 if ab.length_squared() < 0.0001 else clampf((p - a).dot(ab) / ab.length_squared(), 0.0, 1.0)
	return p.distance_to(a + ab * t)


## Все отрезки, вокруг которых прорезаются ущелья: [a, b, полуширина]
static func carve_segments() -> Array:
	var out := []
	for key in ROADS:
		var pts: Array = ROADS[key]
		var form: Array = FORMS.get(key, [])
		var ledge: bool = not form.is_empty() and (form[0] == "ledge" or form[0] == "stilts")
		for i in pts.size() - 1:
			var a := Vector2(pts[i][0], pts[i][2])
			var b := Vector2(pts[i + 1][0], pts[i + 1][2])
			if ledge:
				# ущелье сдвинуто: стена встаёт сразу у края дороги, пропасть — с другой стороны
				var d := (b - a).normalized()
				var n := Vector2(-d.y, d.x) * float(form[1])
				var hw: float = float(ROAD_WIDTH.get(key, 7.5)) * 0.5
				var off := n * (hw - 2.1 - RAVINE)
				out.append([a + off, b + off, RAVINE])
				# у концов дороги — обычное ущелье (стыки с площадками)
				if i == 0:
					out.append([a, a, RAVINE])
				if i == pts.size() - 2:
					out.append([b, b, RAVINE])
			else:
				out.append([a, b, RAVINE])
	for key in PLATFORMS:
		var p: Array = PLATFORMS[key]
		out.append([Vector2(p[0], p[2]), Vector2(p[0], p[2]), float(p[4])])
	for pair in BRIDGES + FAKE_BRIDGES + CRUMBLES + [TWIN_REAL, TWIN_FAKE]:
		out.append([Vector2(pair[0].x, pair[0].z), Vector2(pair[1].x, pair[1].z), RAVINE])
	# пропасть под подъёмником
	out.append([Vector2(LIFT[0].x, LIFT[0].z), Vector2(LIFT[1].x, LIFT[1].z), 20.0])
	out.append([Vector2(PIT.x, PIT.z), Vector2(PIT.x, PIT.z), PIT_HALF + 5.0])
	return out


static func _build_grid() -> void:
	_nx = int((X_MAX - X_MIN) / CELL) + 1
	_nz = int((Z_MAX + 30.0 - Z_MIN) / CELL) + 1
	_grid.resize(_nx * _nz)
	_grid.fill(100.0)
	var reach := WALL + 4.0
	for s in carve_segments():
		var a: Vector2 = s[0]
		var b: Vector2 = s[1]
		var hw: float = s[2]
		var r := hw + reach
		var ix0 := maxi(int(floor((minf(a.x, b.x) - r - X_MIN) / CELL)), 0)
		var ix1 := mini(int(ceil((maxf(a.x, b.x) + r - X_MIN) / CELL)), _nx - 1)
		var iz0 := maxi(int(floor((minf(a.y, b.y) - r - Z_MIN) / CELL)), 0)
		var iz1 := mini(int(ceil((maxf(a.y, b.y) + r - Z_MIN) / CELL)), _nz - 1)
		for iz in range(iz0, iz1 + 1):
			var pz := Z_MIN + iz * CELL
			for ix in range(ix0, ix1 + 1):
				var p := Vector2(X_MIN + ix * CELL, pz)
				var dd := _seg_dist(p, a, b) - hw
				var k := iz * _nx + ix
				if dd < _grid[k]:
					_grid[k] = dd
	# пруды: ущелье вокруг пруда с береговой кромкой
	for pl in POOLS:
		var r2 := 6.0 + reach
		var ix0 := maxi(int(floor((pl[0] - r2 - X_MIN) / CELL)), 0)
		var ix1 := mini(int(ceil((pl[1] + r2 - X_MIN) / CELL)), _nx - 1)
		var iz0 := maxi(int(floor((pl[2] - r2 - Z_MIN) / CELL)), 0)
		var iz1 := mini(int(ceil((pl[3] + r2 - Z_MIN) / CELL)), _nz - 1)
		for iz in range(iz0, iz1 + 1):
			var pz := Z_MIN + iz * CELL
			for ix in range(ix0, ix1 + 1):
				var px := X_MIN + ix * CELL
				var dx := maxf(maxf(pl[0] - px, px - pl[1]), 0.0)
				var dz := maxf(maxf(pl[2] - pz, pz - pl[3]), 0.0)
				var dd := sqrt(dx * dx + dz * dz) - 12.0
				var k := iz * _nx + ix
				if dd < _grid[k]:
					_grid[k] = dd


## Дороги и площадки (для тестов и расстановки): точка на верной дороге по порядку
const CORRECT := ["AE", "AE2", "AE3", "BW", "Q2P", "P2C", "CE", "CE2", "DE", "EN", "LN", "LX"]
